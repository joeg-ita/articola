# Articola configuration. Copy to .env and fill in. Never commit .env (it is git-ignored).

# ─── Database (used by docker compose) ───────────────────────────────────────
POSTGRES_PASSWORD=change-me
# POSTGRES_DB=articola
# POSTGRES_USER=articola

# ─── Public URL ──────────────────────────────────────────────────────────────
# The OAuth redirect URIs are built from it:
#   <BASE_URL>/auth/google/callback      <BASE_URL>/auth/facebook/callback
# Use https:// in production (Secure cookies, HSTS; Google/Facebook require https outside localhost).
BASE_URL=http://localhost:3000
# APP_PORT=3000
# APP_BIND=127.0.0.1          # with the https profile: only Caddy is reachable from outside
# DOMAIN=articola.example.com # for the optional Caddy HTTPS proxy

# ─── Login (OAuth 2.0) ───────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# developers.facebook.com → My Apps → Create App → Facebook Login → Valid OAuth Redirect URIs.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_API_VERSION=v23.0
# A login button is shown only for providers with credentials set.

# ─── AI models ───────────────────────────────────────────────────────────────
# anthropic (default, official SDK) | openai (any OpenAI-compatible chat-completions API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium      # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=true     # server-side refusal fallback (beta): a declined request is retried on another model in the same call

# OpenAI-compatible (OpenAI, OpenRouter, DeepSeek, Groq, Ollama, LM Studio, vLLM...)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_JSON_MODE=json_object  # or json_schema, when the server supports structured outputs
#
# Example, local Ollama:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=qwen2.5:14b

# LLM_TIMEOUT_MS=180000

# ─── Speech-to-text on the server (optional) ─────────────────────────────────
# Without it the browser transcribes (Chrome, Edge, Safari) and the user can correct the text.
# With it, recordings go to an OpenAI-compatible /audio/transcriptions endpoint, which also keeps
# hesitations ("ehm") and makes the filler count more faithful.
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1          # or gpt-4o-transcribe; Groq: whisper-large-v3 with STT_BASE_URL=https://api.groq.com/openai/v1

# ─── Cost & abuse protection ─────────────────────────────────────────────────
# LLM_RATE_PER_HOUR=40         # AI calls per user per hour (path, daily exercises, evaluations, insights)
# PATH_REGEN_PER_DAY=5         # paths a user can (re)generate in 24 hours
# USER_MAX_RECORDINGS=1000
# USER_MAX_AUDIO_MB=400
# SESSION_DAYS=30

# ─── Local development without Docker ────────────────────────────────────────
# DATABASE_URL=postgres://articola:change-me@localhost:5432/articola
# PORT=3000
# Passwordless dev login; needs BOTH lines and is ignored while NODE_ENV=production:
# ENABLE_DEV_LOGIN=true
# NODE_ENV=development
